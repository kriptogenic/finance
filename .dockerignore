# Keep build contexts small and reproducible. Generated Go and the frontend
# build are recreated inside the images; secrets/state must never be copied in.
.git
.idea
.vscode
.DS_Store

# Env & secrets
**/.env
lookout/session.json
lookout/*.session
lookout/lookout-state.json

# Build / dependency output (regenerated in-image)
**/dist
frontend/node_modules

# Generated-from-spec Go (regenerated via oapi-codegen in the build stage)
core/generated/api/*.go
lookout/generated/core/*.go

# Docs & local tooling
**/*.md
