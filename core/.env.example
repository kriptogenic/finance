APP_NAME=finance
HTTP_PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Reporting currency: all cross-account totals and net worth convert to this (ISO 4217).
BASE_CURRENCY=UZS

# Bearer token required by POST /ingest/transactions. Empty = ingest auth disabled (local only).
INGEST_TOKEN=

# HTTP Basic credentials guarding the whole API (the UI logs in with them). Required.
AUTH_USERNAME=finance
AUTH_PASSWORD=finance

# Web Push (PWA badge while the app is closed). All three empty = push disabled.
# Generate a keypair with: go run github.com/SherClockHolmes/webpush-go/... or see README.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=mailto:you@example.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_SSLMODE=disable
DB_MIGRATIONS_PATH=migrations
