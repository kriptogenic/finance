APP_NAME=finance
HTTP_PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Reporting currency: all cross-account totals and net worth convert to this (ISO 4217).
BASE_CURRENCY=UZS

# A note becomes required when a transaction amount exceeds this many minor units.
# 50000000 = 500,000.00 in a 2-decimal currency (e.g. UZS). 0 disables the rule.
NOTE_REQUIRED_ABOVE=50000000

# Bearer token required by the /ingest endpoints (lookout/notifier auth). Required;
# the server refuses to start if unset. Use a strong, high-entropy secret in production.
INGEST_TOKEN=dev-ingest-token

# Bearer token for the /mcp finance-audit endpoint (Claude connects here). Empty
# disables the endpoint entirely. Use a strong, high-entropy secret in production.
MCP_TOKEN=dev-mcp-token

# HTTP Basic credentials guarding the whole API (the UI logs in with them). Required.
AUTH_USERNAME=finance
AUTH_PASSWORD=finance

# Brute-force throttle: max failed-auth (401) attempts per client IP per window
# before further requests get 429. Only failures count; normal traffic is unaffected.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m

# Web Push (PWA badge while the app is closed). All three empty = push disabled.
# Generate a keypair with: go run github.com/SherClockHolmes/webpush-go/... or see README.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=mailto:you@example.com

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance
POSTGRES_SSLMODE=disable
DB_MIGRATIONS_PATH=migrations
