# lookout — Telegram bank-notification userbot config (REQUIREMENTS §9).
# Copy to .env and fill in. SECRETS: TELEGRAM_API_HASH, SESSION_FILE, and
# FINANCE_API_TOKEN — never commit them.

# --- Telegram (MTProto user session) — from https://my.telegram.org ---
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Path to the persisted user session (created on first interactive login).
SESSION_FILE=session.json
# The bank-notification bot's @username (with or without @).
SOURCE_BOT=
# Login method for the one-time interactive auth: "code" (phone + SMS/app code)
# or "qr" (scan a QR from Telegram → Settings → Devices → Link Desktop Device).
AUTH_MODE=code
# Optional: pre-seed the phone for "code" mode (else prompted). For 2FA accounts
# the password is always prompted interactively.
TELEGRAM_PHONE=

# --- Polling & transfer pairing ---
# How often message history is polled.
POLL_INTERVAL=60s
# Max gap between the two legs' transaction times to pair them as a transfer.
TRANSFER_PAIR_WINDOW=120s
# How long an unmatched leg waits before flushing as a standalone expense/income.
# Must exceed POLL_INTERVAL (and TRANSFER_PAIR_WINDOW) — the double-count safeguard.
TRANSFER_HOLD_DURATION=5m

# --- Finance app ingest target ---
FINANCE_API_URL=http://localhost:8080
# Must equal the app's INGEST_TOKEN. Leave empty only for the app's open local mode.
FINANCE_API_TOKEN=secret123

# --- Daily balance reminder ---
# Every day at 08:00 (in TIMEZONE) the bot sends "💰 Баланс" to SOURCE_BOT to
# prompt a fresh balance report, which the poller then ingests. Set true to also
# send once immediately at startup — handy for testing without waiting for 08:00.
BALANCE_SEND_ON_START=false

# --- State & misc ---
# Persisted watermark + pending transfer legs.
STATE_FILE=lookout-state.json
TIMEZONE=Asia/Tashkent
LOG_LEVEL=info
